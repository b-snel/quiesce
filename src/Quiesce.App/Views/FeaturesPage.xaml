<UserControl x:Class="Quiesce.App.Views.FeaturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Quiesce.App.Views">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Features" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Every tweak carries its evidence level and what it breaks. Toggles activate in M3 — this page currently shows live machine state, read-only." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EntryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:FeatureRow}">
                        <ui:Card Margin="0,4" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                Background="{Binding EvidenceBrush}">
                                            <TextBlock Text="{Binding EvidenceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FF0D1117" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Background="#22FFFFFF">
                                            <TextBlock Text="{Binding ImpactLabel}" FontSize="11" Opacity="0.9" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Background="#22FFFFFF">
                                            <TextBlock Text="{Binding TierLabel}" FontSize="11" Opacity="0.9" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Breaks}" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding StatusLabel}" Margin="0,4,0,0" Opacity="0.5" FontSize="12" FontFamily="Consolas" />
                                </StackPanel>

                                <ui:ToggleSwitch Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Tag="{Binding EntryId}"
                                                 IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                 IsEnabled="{Binding CanToggle}"
                                                 Checked="OnToggled"
                                                 Unchecked="OnToggled"
                                                 ToolTip="{Binding ToggleTip}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
