<ui:FluentWindow x:Class="Quiesce.App.Views.PreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Quiesce.App.Views"
        Title="Review changes"
        Width="900" Height="640"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Review changes" />

        <StackPanel Grid.Row="1" Margin="24,8,24,12">
            <TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="This is the exact list Quiesce will write, read live from your machine a moment ago. Each line shows what is there now and what it will become. Nothing has changed yet." />
            <!-- Above the restore-point banner and above the list, because it is the one thing on this
                 dialog that cannot be undone by anything Quiesce or Windows offers afterwards. The list
                 already says "asked to close - Restore will NOT reopen it" per row, which is right at
                 the point of detail and useless as a warning: a browser running nineteen processes is
                 nineteen rows, so the sentence that matters most was also the sentence repeated until
                 it read as boilerplate. Amber, the same as the reboot banner, because both are
                 warnings - drift has its own colour and does not borrow this one. -->
            <Border x:Name="CloseWarning" CornerRadius="6" Padding="16,12" Margin="0,12,0,0"
                    Background="#33D29922" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="20" Opacity="0.85"
                               Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="CloseHeadline" FontWeight="SemiBold" FontSize="14"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Opacity="0.85" FontSize="12.5" TextWrapping="Wrap"
                                   Text="SAVE YOUR WORK FIRST. Each one gets exactly the prompt its X button gives, and Quiesce leaves a save-your-work prompt alone — but Restore will NOT reopen any of them." />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="RestorePointBanner" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                    Background="#22FFFFFF" Visibility="Collapsed">
                <TextBlock x:Name="RestorePointText" TextWrapping="Wrap" FontSize="12" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:PreflightRow}">
                        <Border CornerRadius="6" Padding="14,10" Margin="0,3" Background="#0DFFFFFF">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StepLabel}" FontFamily="Consolas" FontSize="11"
                                               Opacity="0.5" VerticalAlignment="Center" Width="60" />
                                    <TextBlock Text="{Binding EntryId}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#22FFFFFF">
                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="10.5" Opacity="0.8" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Target}" FontFamily="Consolas" FontSize="11"
                                           Opacity="0.6" Margin="60,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Margin="60,4,0,0" FontFamily="Consolas" FontSize="11.5">
                                    <Run Text="now:  " Foreground="#FF8B949E" />
                                    <Run Text="{Binding PriorText, Mode=OneWay}" Foreground="#FFD29922" />
                                </TextBlock>
                                <TextBlock Margin="60,1,0,0" FontFamily="Consolas" FontSize="11.5">
                                    <Run Text="will: " Foreground="#FF8B949E" />
                                    <Run Text="{Binding NewText, Mode=OneWay}" Foreground="#FF3FB950" />
                                </TextBlock>
                                <TextBlock Text="{Binding ActivationText}" Margin="60,4,0,0" FontSize="11"
                                           Opacity="0.55" Visibility="{Binding ActivationVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,16" Background="#14000000">
            <Grid>
                <TextBlock x:Name="ReversibilityNote" VerticalAlignment="Center" Opacity="0.7"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CancelButton" Content="Cancel" Padding="24,8" Click="OnCancel" />
                    <ui:Button x:Name="ApplyButton" Content="Apply these changes" Appearance="Primary"
                               Padding="24,8" Margin="10,0,0,0" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
