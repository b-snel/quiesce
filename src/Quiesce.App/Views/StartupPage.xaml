<UserControl x:Class="Quiesce.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Quiesce.App.Views">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Startup" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="What runs when you sign in. Closing an app that starts itself again at every sign-in is fighting the symptom, so these are standing preferences: unlike everything else in Quiesce, they stay in force across a reboot until you turn them back on. It is the same switch as Task Manager's Startup tab, and Restore puts every one back exactly." />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Rescan" Click="OnRescan" Padding="16,6" />
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" FontSize="12.5" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="Note" Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Background="#18FFFFFF" Visibility="Collapsed">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList" x:FieldModifier="public">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:StartupRow}">
                        <ui:Card Margin="0,4" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Entries still running at sign-in carry the marker: those are the ones
                                     there is anything to do about. -->
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                        Background="{DynamicResource QuiesceAccentBrush}"
                                        Visibility="{Binding OnMarkerVisibility}" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#22FFFFFF">
                                            <TextBlock Text="{Binding LocationLabel}" FontSize="11" Opacity="0.9" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Background="#33D29922"
                                                Visibility="{Binding AdminVisibility}">
                                            <TextBlock Text="admin" FontSize="11" FontWeight="SemiBold" Opacity="0.95" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Background="#33F85149"
                                                Visibility="{Binding UnmanageableVisibility}">
                                            <TextBlock Text="not manageable" FontSize="11" FontWeight="SemiBold" Opacity="0.95" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StateLabel}" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding Command}" Margin="0,4,0,0" Opacity="0.5" FontSize="11.5"
                                               FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ui:Button Content="Turn off at sign-in" Tag="{Binding}" Click="OnDisable"
                                               Padding="12,6"
                                               Visibility="{Binding ActionVisibility}"
                                               ToolTip="Adds a standing preference. It starts switched OFF in Features — turn it on there, then Engage." />
                                    <ui:Button Content="Remove preference" Tag="{Binding}" Click="OnRemove"
                                               Padding="12,6"
                                               Visibility="{Binding RemoveVisibility}"
                                               ToolTip="Deletes the entry you added. Does not itself re-enable the program; Restore does that." />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
