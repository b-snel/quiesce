<UserControl x:Class="Quiesce.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Quiesce.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="820">

            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Two things are configurable. The rest of this page is the things that are not, and why — the same treatment the refusals page gives to features." />

            <!-- Note first, because both writes here can fail on a hardened data root and the outcome has to
                 land somewhere the user is already looking. -->
            <Border x:Name="Note" CornerRadius="6" Padding="14,10" Margin="0,16,0,0"
                    Background="{DynamicResource StateNeutralBrush}" Visibility="Collapsed">
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <!-- ============================================ the two real preferences -->

            <TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Window and notification area" />

            <ui:Card Margin="0,8,0,0" Padding="16,14">
                <StackPanel>
                    <ui:ToggleSwitch x:Name="CloseToTrayToggle" x:FieldModifier="public"
                                     Content="Closing the window keeps Quiesce running"
                                     Checked="OnCloseToTrayChanged" Unchecked="OnCloseToTrayChanged" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12.5"
                               Text="With this on, the X button hides the window and Quiesce keeps running, so the notification area's sync check stays reachable. With it off, the X button exits and the icon goes with it. Either way this machine stays engaged — only Restore un-engages a machine." />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0" Padding="16,14">
                <StackPanel>
                    <ui:ToggleSwitch x:Name="StartAtSignInToggle" x:FieldModifier="public"
                                     Content="Start Quiesce when I sign in"
                                     Checked="OnStartAtSignInChanged" Unchecked="OnStartAtSignInChanged" />
                    <TextBlock x:Name="StartAtSignInDetail" Margin="0,8,0,0" Opacity="0.7"
                               TextWrapping="Wrap" FontSize="12.5" />
                </StackPanel>
            </ui:Card>

            <!-- ============================================ read-only facts -->

            <TextBlock Margin="0,28,0,0" FontSize="16" FontWeight="SemiBold" Text="This machine" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12.5"
                       Text="Moved here off the dashboard, which is for the one question you open the app to ask." />

            <ui:Card Margin="0,8,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="EnvironmentDetail" FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" />
                    <ui:Button x:Name="CopyPathButton" Content="Copy data root path" Margin="0,12,0,0"
                               Padding="16,6" Click="OnCopyPath" />
                </StackPanel>
            </ui:Card>

            <!-- ============================================ not configurable, and why -->

            <TextBlock Margin="0,28,0,0" FontSize="16" FontWeight="SemiBold" Text="Not configurable, and why" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12.5"
                       Text="A missing setting reads as an oversight. These are decisions." />

            <ItemsControl x:Name="RefusalList" Margin="0,8,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:SettingRefusalRow}">
                        <ui:Card Margin="0,4" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Reason}" Margin="0,6,0,0" Opacity="0.7"
                                           TextWrapping="Wrap" FontSize="12.5" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
