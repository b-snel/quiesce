<UserControl x:Class="Quiesce.App.Views.RunningAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Quiesce.App.Views">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Running apps" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Applications running right now that Quiesce is allowed to act on. Adding one writes a catalog entry pinned to its image name and the folder it is installed in — the same rule every shipped entry uses. Games, launchers, anti-cheat, services and Windows' own processes are not listed, because Quiesce will not touch them." />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Rescan" Click="OnRescan" Padding="16,6" />
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" FontSize="12.5" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="Note" Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Background="#18FFFFFF" Visibility="Collapsed">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:AppRow}">
                        <ui:Card Margin="0,4" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#22FFFFFF">
                                            <TextBlock Text="{Binding ProcessLabel}" FontSize="11" Opacity="0.9" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Background="#33D29922"
                                                Visibility="{Binding CoveredVisibility}">
                                            <TextBlock Text="already in the catalog" FontSize="11" FontWeight="SemiBold" Opacity="0.95" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding PathLabel}" Margin="0,4,0,0" Opacity="0.5" FontSize="11.5"
                                               FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ui:Button Content="Close on Engage" Tag="{Binding}" Click="OnAddClose"
                                               Padding="12,6" Visibility="{Binding AddVisibility}"
                                               IsEnabled="{Binding CanClose}"
                                               ToolTip="{Binding CloseTip}" />
                                    <ui:Button Content="Throttle" Tag="{Binding}" Click="OnAddThrottle"
                                               Padding="12,6" Margin="8,0,0,0" Visibility="{Binding AddVisibility}"
                                               ToolTip="Lower its priority while engaged. Restore puts it back exactly." />
                                    <ui:Button Content="Remove" Tag="{Binding}" Click="OnRemove"
                                               Padding="12,6" Visibility="{Binding RemoveVisibility}"
                                               ToolTip="Deletes the entry you added. Shipped entries cannot be removed here." />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
