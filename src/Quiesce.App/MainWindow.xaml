<ui:FluentWindow x:Class="Quiesce.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Quiesce"
        Width="1060" Height="720"
        MinWidth="820" MinHeight="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Quiesce" Icon="pack://application:,,,/Assets/logo-dark.png" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Simple, fully-controlled navigation: a themed ListBox + ContentControl. The stock
                 NavigationView needs a page-provider service and brings routing machinery this
                 read-only shell doesn't earn yet; revisit if navigation grows features. -->
            <ListBox x:Name="Nav"
                     Grid.Column="0"
                     Margin="8,4,4,8"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnNavSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <!-- Fully retemplated: the stock ListBoxItem selection brush renders as a solid
                         accent block here, which reads as an error state rather than navigation. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Margin="0,2"
                                            Padding="14,10"
                                            CornerRadius="6"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Pill"
                                                    Grid.Column="0"
                                                    Width="3" Height="16"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    Background="Transparent" />
                                            <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                            <Setter TargetName="Pill" Property="Background"
                                                    Value="{DynamicResource QuiesceAccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Grid.Column="1" Margin="4,4,12,12">
                <ContentControl x:Name="PageHost" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
