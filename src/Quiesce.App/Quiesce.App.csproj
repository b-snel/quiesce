<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Quiesce.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>Quiesce</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Whole-app elevation. Justified in the plan: this is a personal tool, a split
         GUI+broker design doubles the work, and the LPE concern that motivates the split is
         neutralised by installing to an admin-only path (verified by ACL check at startup). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\quiesce.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pages expose the controls a test needs with x:FieldModifier="public", but a decision that
         is not a control - which brush, which headline, which tray items, whether a button is enabled
         after a busy cycle - has nowhere to be asserted from without this. Kept internal rather than
         made public for the same reason Core does it: the test seam should not widen the API. -->
    <InternalsVisibleTo Include="Quiesce.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 512px logos for in-app use (About page, tray). The .ico is the dark logo at
         16/24/32/48/64/128/256 - the glowing rings read on both light and dark taskbars. -->
    <Resource Include="Assets\logo-dark.png" />
    <Resource Include="Assets\logo-light.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quiesce.Core\Quiesce.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" />
    <PackageReference Include="NetSparkleUpdater.UI.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
