<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are self-executing, so OutputType must be Exe. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Quiesce.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Needed to construct the WPF pages in ViewConstructionTests. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quiesce.Core\Quiesce.Core.csproj" />
    <ProjectReference Include="..\..\src\Quiesce.App\Quiesce.App.csproj" />
    <!-- ReferenceOutputAssembly=false: the CLI contract tests spawn quiesce.exe as a process
         rather than linking it, but the build order must still guarantee the exe exists. -->
    <ProjectReference Include="..\..\src\Quiesce.Cli\Quiesce.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF removes System.IO from the implicit usings (System.Windows.Shapes.Path collision);
         the engine tests use it heavily, so bring it back globally. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
